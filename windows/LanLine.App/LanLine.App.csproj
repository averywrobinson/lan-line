<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Lan-Line</AssemblyName>
    <ApplicationIcon>LanLine.ico</ApplicationIcon>
    <Product>Lan-Line</Product>
    <AssemblyTitle>Lan-Line</AssemblyTitle>
    <RootNamespace>LanLine.App</RootNamespace>
    <StartupObject>LanLine.App.Program</StartupObject>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.9.0</Version>
    <InformationalVersion>0.9.0-beta.8</InformationalVersion>
    <Copyright>Lan-Line. MIT License.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="LanLine.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LanLine.Core\LanLine.Core.csproj" />
  </ItemGroup>
</Project>
