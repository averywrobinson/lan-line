<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon, beta.9); its global usings would clash with WPF's names. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Toasts call the WinRT notification classes through their vtables (Notify.cs, beta.10): no packages. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Lan-Line</AssemblyName>
    <ApplicationIcon>LanLine.ico</ApplicationIcon>
    <Product>Lan-Line</Product>
    <AssemblyTitle>Lan-Line</AssemblyTitle>
    <RootNamespace>LanLine.App</RootNamespace>
    <StartupObject>LanLine.App.Program</StartupObject>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.9.0</Version>
    <InformationalVersion>0.9.0-beta.11</InformationalVersion>
    <Copyright>Lan-Line. MIT License.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="LanLine.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LanLine.Core\LanLine.Core.csproj" />
  </ItemGroup>
</Project>
